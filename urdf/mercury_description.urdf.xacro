<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mercury_description">

  <xacro:include filename="$(find tr_robot_description)/urdf/inc/create_link.xacro"/>

  <xacro:create_link
      link_name="base_link"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_Base"
      ixx="0.00443333156"
      iyy="0.00443333156"
      izz="0.0072"
      mass="4.0"
  />

  <xacro:create_link
      link_name="link_1"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J1"
      ixx="0.010267495893"
      iyy="0.010267495893"
      izz="0.00666"
      mass="3.7"
  />

  <xacro:create_link
      link_name="link_2"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J2"
      ixx="0.1338857818623325"
      iyy="0.1338857818623325"
      izz="0.0151074"
      mass="8.393"
  />

  <xacro:create_link
      link_name="link_3"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J3"
      ixx="0.031209355099586295"
      iyy="0.031209355099586295"
      izz="0.004095"
      mass="2.275"
  />

  <xacro:create_link
      link_name="link_4"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J4"
      ixx="0.0025598989760400002"
      iyy="0.0025598989760400002"
      izz="0.0021942"
      mass="1.219"
  />

  <xacro:create_link
      link_name="link_5"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J5"
      ixx="0.0025598989760400002"
      iyy="0.0025598989760400002"
      izz="0.0021942"
      mass="1.219"
  />

  <xacro:create_link
      link_name="link_6"
      xyz_offset="0 0 0"
      rpy_offset="0 0 0"
      mesh_name="ROS2_J6"
      ixx="9.890410052167731e-05"
      iyy="9.890410052167731e-05"
      izz="0.0001321171875"
      mass="0.1879"
  />

  <link name="ft_frame"/>
  <link name="tool0"/>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.117" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="-0.081 0 0.101" rpy="0 ${-pi/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="150.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.35 0 -0.0035" rpy="${pi} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="80.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.0805 0 0.0775" rpy="0 ${pi/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.2695" rpy="0 ${-pi/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.1705 0 0" rpy="0 ${pi/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
  </joint>

  <joint name="joint-ft_frame" type="fixed">
    <parent link="link_6"/>
    <child link="ft_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint-tool" type="fixed">
    <parent link="ft_frame"/>
    <child link="tool0"/>
    <origin xyz="0 0 .185" rpy="0 0 0"/>
  </joint>

</xacro:macro>

</robot>