<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mercury_gazebo_ros2_control">

    <ros2_control name="GazeboSystem" type="system">
    
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-6.29</param>
        <param name="max">6.29</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">150.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-6.29</param>
        <param name="max">6.29</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">150.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">80.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">28.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">28.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6">
      <command_interface name="position">
        <param name="min">-6.28</param>
        <param name="max">6.28</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="max">2.01</param>
      </command_interface>
      <command_interface name="effort">
        <param name="max">28.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- Gazebo's ros2_control plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>
      <parameters>$(find tr_bringup)/config/gazebo_controller_configuration.yaml</parameters>
    </plugin>
  </gazebo>

  </xacro:macro>

</robot>